# Copy to apps/web/.env.local (git-ignored) and fill in the values.

# Pooled Neon connection used by the app at runtime (see packages/db/README.md).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Random secret used to hash client IP addresses for waitlist rate limiting
# (required in production). Generate one with: openssl rand -hex 32
IP_HASH_SECRET=

# Resend (https://resend.com) for authentication emails. Without a key, emails
# are printed in the terminal (development). EMAIL_FROM needs a domain verified
# in Resend; the default sender can only write to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM="Bible Plan <onboarding@resend.dev>"
