# Copy to apps/web/.env.local (git-ignored) and fill in the values.

# Pooled Neon connection used by the app at runtime (see packages/db/README.md).
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Random secret used to hash client IP addresses for waitlist rate limiting
# (required in production). Generate one with: openssl rand -hex 32
IP_HASH_SECRET=

# Resend (https://resend.com) for authentication emails. Without a key, emails
# are printed in the terminal (development). EMAIL_FROM needs a domain verified
# in Resend; the default sender can only write to the Resend account owner.
RESEND_API_KEY=
EMAIL_FROM="Bible Plan <onboarding@resend.dev>"

# better-auth: random secret (openssl rand -base64 32) and public URL of the app.
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000

# Google sign-in (optional): OAuth client from Google Cloud Console, with the
# redirect URI <BETTER_AUTH_URL>/api/auth/callback/google. Hidden when empty.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Secret of the scheduled reminder dispatch: the GitHub Actions workflow sends
# it as a bearer token to POST /api/cron/dispatch (same value as the CRON_SECRET
# repository secret). Without it the route refuses every call.
# Generate one with: openssl rand -hex 32
CRON_SECRET=

# Set to "true" to also send reminders by email (needs RESEND_API_KEY and a
# verified domain). Off by default: reminders then reach the app only.
EMAIL_REMINDERS_ENABLED=

# Web Push (reminders on the phone or computer): the key pair that identifies
# the server to push services. Generate it with:
#   pnpm --filter @workspace/notifications push:keys
# VAPID_SUBJECT is a contact for the push services (mailto: or https:).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=

# YouVersion Platform API key (https://platform.youversion.com): serves the text
# of more translations (BSB, WEB, Ostervald, and NIV and La Bible du Semeur once
# the Biblica licence is accepted for the key in the portal). Server only: it is
# never sent to the browser. After a licence change, refresh the list with
#   pnpm --filter @workspace/bible-data import:youversion
YOUVERSION_API_KEY=

