// Database schema for Bible Plan. Models are added by the feature issues
// (auth, plans, reminders, prayer, groups...). See README.md for the workflow.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Waitlist (teaser landing, before launch) ───────────────────────────────

enum WaitlistInterest {
  PLANS
  REMINDERS
  PRAYER
  MEDITATION
  GROUPS
}

/// Person interested in the app, collected by the waitlist landing page.

model WaitlistEntry {
  id          String             @id @default(uuid(7))
  /// Normalized (trimmed, lowercase).
  email       String             @unique
  firstName   String?
  /// ISO 3166-1 alpha-2 code, e.g. "CM".
  countryCode String?            @db.Char(2)
  interests   WaitlistInterest[]
  /// Language used on the landing page ("fr" or "en").
  locale      String             @db.VarChar(5)
  consentedAt DateTime
  /// HMAC of the client IP address, only used for rate limiting.
  ipHash      String?
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([ipHash, createdAt])
}

// ─── Emails ─────────────────────────────────────────────────────────────────

/// Emails sent per UTC day, to stay within the provider's daily quota.

model EmailDailyUsage {
  day       DateTime @id @db.Date
  sent      Int      @default(0)
  updatedAt DateTime @updatedAt
}

// ─── Authentication (better-auth, generated: pnpm --filter @workspace/auth auth:generate) ─

model User {
  id                 String              @id
  name               String
  email              String
  emailVerified      Boolean             @default(false)
  image              String?
  createdAt          DateTime            @default(now())
  updatedAt          DateTime            @updatedAt
  sessions           Session[]
  accounts           Account[]
  ownedPlans         ReadingPlan[]
  enrollments        PlanEnrollment[]
  reminders          Reminder[]
  notifications      Notification[]
  highlights         Highlight[]
  prayerRequests     PrayerRequest[]
  meditationSessions MeditationSession[]
  meditationNotes    MeditationNote[]
  pushDevices        PushDevice[]

  locale       String  @default("fr")
  timezone     String?
  readingWpm   Int     @default(180)
  bibleVersion String?

  @@unique([email])
  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([token])
  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  user                  User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}

// ─── Reading plans ──────────────────────────────────────────────────────────
// A plan is generated once by @workspace/core (generatePlan) and stored day by
// day. People follow a plan through an enrollment, which holds their progress:
// the same plan can later be followed by every member of a group.

/// What to do when readings are late (see planCatchUp in @workspace/core).
enum CatchUpStrategy {
  SHIFT
  REDISTRIBUTE
  FREE
}

enum PlanEnrollmentStatus {
  ACTIVE
  PAUSED
  ARCHIVED
}

model ReadingPlan {
  id              String          @id @default(uuid(7))
  ownerId         String
  owner           User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  title           String
  /// Key of the template it was created from (core plan templates), if any.
  templateKey     String?
  startDate       DateTime        @db.Date
  endDate         DateTime        @db.Date
  /// Days of the week with a reading, 0 = Sunday.
  activeWeekdays  Int[]
  /// Generator input, to rebuild the remaining days (catch-up):
  /// tracks = [{ name?: { fr, en }, passages: Passage[] }], pace = PlanPace.
  tracks          Json
  pace            Json
  totalDays       Int
  totalVerses     Int
  /// Chosen by the owner: SHIFT keeps the daily load, REDISTRIBUTE the end date.
  catchUpStrategy CatchUpStrategy @default(SHIFT)
  /// Number of PlanReading rows, to show the progress without loading them.
  totalReadings   Int             @default(0)
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  days        PlanDay[]
  enrollments PlanEnrollment[]

  @@index([ownerId])
}

model PlanDay {
  id        String        @id @default(uuid(7))
  planId    String
  plan      ReadingPlan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  /// 1 for the first reading day.
  dayNumber Int
  date      DateTime      @db.Date
  verses    Int
  readings  PlanReading[]

  @@unique([planId, dayNumber])
  @@index([planId, date])
}

/// One passage of a day (verse range inside one book, OSIS book code).
model PlanReading {
  id           String            @id @default(uuid(7))
  dayId        String
  day          PlanDay           @relation(fields: [dayId], references: [id], onDelete: Cascade)
  /// Order inside the day.
  position     Int
  /// Index of the track in ReadingPlan.tracks.
  track        Int
  book         String
  startChapter Int
  startVerse   Int
  endChapter   Int
  endVerse     Int
  verses       Int
  progress     ReadingProgress[]

  @@unique([dayId, position])
}

model PlanEnrollment {
  id        String               @id @default(uuid(7))
  planId    String
  plan      ReadingPlan          @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId    String
  user      User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  status    PlanEnrollmentStatus @default(ACTIVE)
  createdAt DateTime             @default(now())
  updatedAt DateTime             @updatedAt
  progress  ReadingProgress[]

  @@unique([planId, userId])
  @@index([userId, status])
}

/// A reading marked as read by an enrollment. Unique, so marking twice is a no-op.
model ReadingProgress {
  id           String         @id @default(uuid(7))
  enrollmentId String
  enrollment   PlanEnrollment @relation(fields: [enrollmentId], references: [id], onDelete: Cascade)
  readingId    String
  reading      PlanReading    @relation(fields: [readingId], references: [id], onDelete: Cascade)
  completedAt  DateTime       @default(now())

  @@unique([enrollmentId, readingId])
  @@index([readingId])
}

// ─── Reminders ──────────────────────────────────────────────────────────────
// A reminder fires at a local time, in the person's time zone, on some days of
// the week. nextRunAt (UTC) is computed by @workspace/core (nextReminderRun) and
// moved forward each time the reminder is delivered. A delivery is one channel
// of one occurrence, unique so that a retried cron run never notifies twice.

enum ReminderKind {
  READING
  PRAYER
  MEDITATION
}

enum ReminderChannel {
  /// Always available: the notification centre of the app.
  IN_APP
  PUSH
  /// Offered only while EMAIL_REMINDERS_ENABLED is on.
  EMAIL
}

model Reminder {
  id        String            @id @default(uuid(7))
  userId    String
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      ReminderKind
  /// Local time "HH:mm", in 5-minute steps (the cron runs every 5 minutes).
  localTime String            @db.VarChar(5)
  /// IANA time zone the local time is read in, e.g. "Europe/Paris".
  timezone  String
  /// Days of the week the reminder is active, 0 = Sunday.
  weekdays  Int[]
  channels  ReminderChannel[]
  enabled   Boolean           @default(true)
  /// Next occurrence (UTC); null while the reminder is disabled.
  nextRunAt DateTime?
  lastRunAt DateTime?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt

  deliveries ReminderDelivery[]

  @@index([enabled, nextRunAt])
  @@index([userId])
}

model ReminderDelivery {
  id         String          @id @default(uuid(7))
  reminderId String
  reminder   Reminder        @relation(fields: [reminderId], references: [id], onDelete: Cascade)
  /// The occurrence this delivery is for (the reminder's nextRunAt at the time).
  dueAt      DateTime
  channel    ReminderChannel
  sentAt     DateTime        @default(now())
  /// Why the channel failed, if it did.
  error      String?

  @@unique([reminderId, dueAt, channel])
}

// ─── Notifications ──────────────────────────────────────────────────────────
// What the bell and the notifications page show. Created by the server (a due
// reminder, later group events), text already in the language of the person.

enum NotificationType {
  REMINDER
}

model Notification {
  id        String           @id @default(uuid(7))
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      NotificationType
  title     String
  body      String?
  /// Where the notification leads, a path of the app without the language.
  href      String?
  /// Null while unread.
  readAt    DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
  @@index([createdAt])
}

// ─── Highlights ─────────────────────────────────────────────────────────────
// A verse colored by a person in the reader. Verses are numbered like the
// canon (King James, as in plans), whatever version was on screen, so a
// highlight shows in every version.

enum HighlightColor {
  YELLOW
  ORANGE
  GREEN
  BLUE
  PURPLE
  PINK
}

model Highlight {
  id        String         @id @default(uuid(7))
  userId    String
  user      User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OSIS book code, e.g. "John".
  book      String
  chapter   Int
  /// Verse number in the numbering of the canon.
  verse     Int
  color     HighlightColor
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt

  @@unique([userId, book, chapter, verse])
  @@index([userId, book, chapter])
}

// ─── Push devices ───────────────────────────────────────────────────────────
// Where a push notification can be sent for a user: a browser subscribed with
// the Web Push API, or (later) a phone with the Expo app.

enum PushDeviceKind {
  WEB_PUSH
  EXPO
}

model PushDevice {
  id         String         @id @default(uuid(7))
  userId     String
  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind       PushDeviceKind
  /// The address to push to: the subscription endpoint of a browser, or the
  /// Expo push token. Unique, so subscribing again from a device is a no-op.
  token      String         @unique
  /// Web Push only: the keys of the subscription (p256dh and auth).
  p256dh     String?
  auth       String?
  /// Browser and system, to tell devices apart in the settings.
  userAgent  String?
  createdAt  DateTime       @default(now())
  /// The last push accepted by the push service.
  lastUsedAt DateTime?

  @@index([userId])
}

// ─── Prayer journal ─────────────────────────────────────────────────────────
// What a person prays for, when they last prayed, and what was answered.
// Private to the owner: nothing here is shared (groups come later).

enum PrayerCategory {
  PERSONAL
  FAMILY
  FRIENDS
  CHURCH
  WORLD
  OTHER
}

enum PrayerStatus {
  ACTIVE
  ANSWERED
  ARCHIVED
}

model PrayerRequest {
  id           String         @id @default(uuid(7))
  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  details      String?
  category     PrayerCategory @default(PERSONAL)
  status       PrayerStatus   @default(ACTIVE)
  /// The day the person started praying for it (a calendar date).
  startedOn    DateTime       @default(now()) @db.Date
  /// Passages that go with the prayer, as passage slugs ("Ps.51.1-4").
  passages     String[]       @default([])
  /// The last time the person said "I prayed"; null until the first time.
  lastPrayedAt DateTime?
  prayerCount  Int            @default(0)
  /// The day it was answered, chosen by the person (a calendar date).
  answeredOn   DateTime?      @db.Date
  /// What happened: the circumstances of the answer.
  answerNote   String?
  createdAt    DateTime       @default(now())
  updatedAt    DateTime       @updatedAt
  logs         PrayerLog[]

  @@index([userId, status, updatedAt])
}

/// One "I prayed", kept so that streaks and statistics can count prayer days.
model PrayerLog {
  id        String        @id @default(uuid(7))
  requestId String
  request   PrayerRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)
  userId    String
  prayedAt  DateTime      @default(now())

  @@index([userId, prayedAt])
  @@index([requestId])
}

// ─── Meditation ─────────────────────────────────────────────────────────────
// A timed session, with a passage to meditate on. The duration is the time
// really spent, which can be shorter than planned.

model MeditationSession {
  id              String           @id @default(uuid(7))
  userId          String
  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// The passage meditated on, as a passage slug ("Ps.23"); optional.
  passage         String?
  plannedSeconds  Int
  /// The time really spent, pauses excluded.
  durationSeconds Int
  startedAt       DateTime
  createdAt       DateTime         @default(now())
  notes           MeditationNote[]

  @@index([userId, startedAt])
}

/// What a person wrote about a passage: the key verse, a reflection and how
/// they will live it. Linked to a passage, and to the book for filtering.
model MeditationNote {
  id          String             @id @default(uuid(7))
  userId      String
  user        User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  /// OSIS book code of the passage, to find notes by book.
  book        String
  /// The passage, as a passage slug ("John.3.1-21").
  passage     String
  /// The key verse, as a passage slug ("John.3.16"); optional.
  keyVerse    String?
  reflection  String?
  application String?
  /// The session the note was written after, if any.
  sessionId   String?
  session     MeditationSession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)
  createdAt   DateTime           @default(now())
  updatedAt   DateTime           @updatedAt

  @@index([userId, book, updatedAt])
  @@index([userId, updatedAt])
}
