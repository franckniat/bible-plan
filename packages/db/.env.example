# Copy to packages/db/.env (used by the Prisma CLI: migrate, studio, seed).
# Neon dashboard → Connect → choose the branch and database.

# Pooled connection (host contains "-pooler"), used by the application at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"

# Direct connection (same host without "-pooler"), used for migrations.
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/DATABASE?sslmode=require&channel_binding=require"
