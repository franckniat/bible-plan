{
  "name": "@workspace/auth",
  "version": "0.0.0",
  "type": "module",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "lint": "eslint --max-warnings 0",
    "format": "prettier --write \"**/*.{ts,tsx}\"",
    "typecheck": "tsc --noEmit",
    "auth:generate": "node --env-file-if-exists=../db/.env ./node_modules/auth/dist/index.mjs generate --config ./auth.cli.ts --output ../db/prisma/schema.prisma --yes"
  },
  "dependencies": {
    "@workspace/db": "workspace:*",
    "@workspace/notifications": "workspace:*",
    "better-auth": "^1.7.7"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "auth": "^1.7.7",
    "eslint": "^10",
    "typescript": "^5"
  },
  "exports": {
    ".": "./src/index.ts"
  }
}
