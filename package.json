{
  "name": "bible-plan",
  "version": "0.0.1",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "lint": "turbo lint",
    "format": "turbo format",
    "typecheck": "turbo typecheck",
    "test": "turbo test",
    "test:watch": "turbo test:watch",
    "db:generate": "turbo db:generate",
    "db:migrate": "pnpm --filter @workspace/db db:migrate",
    "db:deploy": "pnpm --filter @workspace/db db:deploy",
    "db:studio": "pnpm --filter @workspace/db db:studio",
    "db:seed": "pnpm --filter @workspace/db db:seed",
    "db:waitlist:remove": "pnpm --filter @workspace/db waitlist:remove",
    "email:test": "pnpm --filter @workspace/notifications email:test"
  },
  "devDependencies": {
    "@workspace/eslint-config": "workspace:*",
    "@workspace/typescript-config": "workspace:*",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "turbo": "^2.11.5",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0",
  "engines": {
    "node": ">=20.9.0"
  }
}
